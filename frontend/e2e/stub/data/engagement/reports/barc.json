  "recommendations": {
    "headline": "Ratings build through the tea ritual, peak on the balcony joke with Mr. Rao and fall away once the end card appears.",
    "do_more": [
      {
        "title": "Give the banter more room",
        "rationale": "The humour between Asha and Mr. Rao coincides with the highest ratings of the spot. A cut that reaches it sooner, or stays with it longer, keeps more of the audience.",
