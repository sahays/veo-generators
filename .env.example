# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=aug18-25-3
GOOGLE_CLOUD_LOCATION=asia-south1
GEMINI_REGION=global
VEO_REGION=global
GCS_BUCKET=aug18-25-3-veo-generators-media

# AI Model Configuration
OPTIMIZE_PROMPT_MODEL=gemini-3.8-flash
STORYBOARD_MODEL=gemini-nano-banana-2.1
ADAPTS_MODEL=gemini-nano-banana-2.1
VIDEO_GEN_MODEL=gemini-omni-1.1-flash-preview
AVATAR_VIDEO_MODEL=gemini-omni-1.1-flash-preview
GEMINI_AGENT_ORCHESTRATOR=gemini-3.5-flash-lite
REFRAME_DECISION_MODEL=gemini-3.5-flash-lite
REFRAME_SEMANTIC_MODEL=gemini-3.5-flash-lite
AVATAR_LIVE_MODEL=gemini-3.8-live
AVATAR_LIVE_LOCATION=us
AVATAR_LIVE_PROJECT=aug18-25-3

# Dubbing (Gemini Live Translate)
# NOTE: live-translate is Gemini Developer API only — it is not on Vertex AI.
# This is the one feature that authenticates with an API key instead of ADC.
# Prefer Secret Manager over a plain env var in deployed environments.
GEMINI_API_KEY=your-developer-api-key
DUBBING_LIVE_MODEL=gemini-3.5-live-translate-preview
DUBBING_LIVE_SURFACE=developer
DUBBING_LIVE_LOCATION=global
# The target-language list is NOT configurable here. The codes are the Live
# Translate model's contract, so they live in code: api/models_records.py,
# DUB_LANGUAGES. Add or remove a language there.
# Session length cap — Live sessions are limited to 15 min audio-only.
DUBBING_WINDOW_SEC=600
# Input stream rate vs realtime. 1.0 gives the best alignment; 2.0 is faster
# but pushes interpreter lag from ~3.4s to ~4.7s.
DUBBING_PACE=1.0
# The model sends no completion flag — it streams silent keep-alive audio after
# translating. Draining stops after this much continuous silence.
DUBBING_SILENCE_STOP_SEC=4.0
DUBBING_MAX_SOURCE_MINUTES=30
DUBBING_MAX_LANGUAGES=4

# Service Configuration
SERVICE_NAME=veo-generators
ARTIFACT_REPO=superexam-repo

# Auth
MASTER_INVITE_CODE=your-master-invite-code

# Frontend (Vite) — guest invite code used to silently log new visitors in
# as read-only users. Must match an active invite code in Firestore.
VITE_GUEST_INVITE_CODE=guest
