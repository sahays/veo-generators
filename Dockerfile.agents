FROM python:3.12-slim
WORKDIR /app

# Install lightweight ADK + HTTP dependencies only (no FFmpeg, OpenCV, Firestore, or GCS)
COPY agents_service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy only the isolated agents package and microservice entrypoint
COPY api/agents ./agents
COPY agents_service/main.py ./main.py

ENV PORT=8080
ENV GOOGLE_GENAI_USE_VERTEXAI=true
ENV GEMINI_AGENT_ORCHESTRATOR=gemini-3.5-flash-lite
ENV GEMINI_AGENT_FINOPS_MODEL=gemini-3.5-flash-lite
ENV GEMINI_AGENT_SPECIALIST_MODEL=gemini-3.8-flash
ENV GEMINI_AGENT_CREATIVE_MODEL=gemini-3.8-flash

EXPOSE 8080

CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8080}"]
