# --- Blender 4.2 LTS (headless greybox previz renderer) -------------------------------
# `blender_src` only provides /blender.tar.xz; local builds may override it with
#   docker build --build-context blender_src=<dir containing blender.tar.xz> ...
FROM scratch AS blender_src
ADD --checksum=sha256:bea0eb3146be13eae6225409a117b215184f41b7f79e799f97cb3abb8f6dc404 \
    https://download.blender.org/release/Blender4.2/blender-4.2.23-linux-x64.tar.xz /blender.tar.xz

FROM debian:bookworm-slim AS blender_unpack
RUN apt-get update && apt-get install -y --no-install-recommends xz-utils \
    && rm -rf /var/lib/apt/lists/*
COPY --from=blender_src /blender.tar.xz /tmp/blender.tar.xz
# Strip only parts never loaded headless: GLX-only software Mesa (we render via EGL),
# GPU-only denoiser devices, the unlinked old SYCL runtime, desktop/launcher files.
RUN mkdir -p /opt/blender \
    && tar -xJf /tmp/blender.tar.xz -C /opt/blender --strip-components=1 \
    && rm -rf /tmp/blender.tar.xz /opt/blender/lib/mesa \
        /opt/blender/lib/libOpenImageDenoise_device_cuda.so* \
        /opt/blender/lib/libOpenImageDenoise_device_hip.so* \
        /opt/blender/lib/libOpenImageDenoise_device_sycl.so* \
        /opt/blender/lib/libsycl.so.6* \
        /opt/blender/blender-softwaregl /opt/blender/blender-launcher \
        /opt/blender/blender-thumbnailer /opt/blender/*.desktop /opt/blender/*.svg

# --- Service image -------------------------------------------------------------------
FROM python:3.12-slim
WORKDIR /app

# ffmpeg + the X/GL client libs Blender links against + Mesa EGL (llvmpipe) so Workbench
# renders on CPU-only Cloud Run with `blender -b` (no X server, no GPU).
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libx11-6 libxrender1 libxxf86vm1 libxfixes3 libxi6 libxkbcommon0 libsm6 libice6 \
    libgl1 libegl1 libegl-mesa0 libgl1-mesa-dri \
    && rm -rf /var/lib/apt/lists/*

COPY --from=blender_unpack /opt/blender /opt/blender
RUN ln -s /opt/blender/blender /usr/local/bin/blender
ENV BLENDER_BIN=/opt/blender/blender

COPY productions_service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# Bake the htdemucs weights (~80 MB) into the image: no cold-start download (audio.mode=stems).
RUN python -c "from demucs.pretrained import get_model; get_model('htdemucs')"

COPY productions_service/storygraph ./storygraph
COPY productions_service/routers ./routers
COPY productions_service/services ./services
COPY productions_service/main.py ./main.py

ENV PORT=8080
ENV GOOGLE_GENAI_USE_VERTEXAI=true
ENV GEMINI_AGENT_SPECIALIST_MODEL=gemini-3.8-flash
ENV GEMINI_AGENT_CREATIVE_MODEL=gemini-3.8-flash
ENV STORYBOARD_MODEL=gemini-nano-banana-2.1
ENV VIDEO_GEN_MODEL=gemini-omni-1.1-flash-preview

EXPOSE 8080

CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8080}"]
